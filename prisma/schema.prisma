datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model StudentProfile {
  id                      String   @id @default(cuid())
  name                    String
  tagline                 String
  objective               String
  contactPhone            String
  contactEmail            String
  contactLocation         String
  contactLinkedIn         String
  contactGitHub           String
  contactPortfolio        String
  
  status                  String   @default("PENDING") // PENDING, APPROVED
  
  educationalQualifications String   // JSON of array of { qualification, institution, year, cgpa }
  certifications            String   // JSON array of strings
  technicalExpertise        String   // JSON array of strings
  projects                  String   // JSON array of { title, role, description }
  strengths                 String   // JSON array of strings
  
  profileImageBase64        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}
